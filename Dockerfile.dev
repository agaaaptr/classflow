FROM node:24-alpine

RUN apk add --no-cache libc6-compat

WORKDIR /app

COPY package.json package-lock.json ./
# npm install (not npm ci): the lockfile is generated on macOS, so a strict
# clean install would miss the Linux/musl optional deps (e.g. @emnapi/* WASM
# fallbacks of @tailwindcss/oxide). install re-resolves for the container platform.
RUN npm install --no-audit --no-fund

COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0"]
